# Copy to env/production.env and fill in. The real file is gitignored.
#
# Production ADP org. rpai uses its default config for the desk-head identity
# and ~/.rpai/broker(.credentials) for the broker (AS=broker).

CLUSTER_ID=<adp-cluster-id>
DATAPLANE_API=https://api-<id>.<cluster-id>.byoc.prd.cloud.redpanda.com
AIGW_URL=https://aigw.<cluster-id>.clusters.rdpa.co
ADP_API_URL=https://adp-api.<cluster-id>.clusters.rdpa.co

# Must already exist in the org and allow the model below.
LLM_PROVIDER=anthropic-api-key
LLM_MODEL=claude-sonnet-4-6

# --- Postgres -------------------------------------------------------------
# Must be reachable from the AI gateway over the public internet with TLS.
# The gateway refuses to dial private addresses.
PG_HOST=<host>
PG_PORT=5432
PG_DATABASE=otc_desk_demo

# --- The two demo identities ---------------------------------------------
# Both must be real users in the org. Service accounts do not work: the gateway
# treats them as infrastructure, not people. Policies target individual users;
# group targeting is unsupported and refuses every call on the server.
DESK_HEAD_EMAIL=desk.head@example.com
BROKER_EMAIL=rates.broker@example.com

# --- Resource names — usually fine as-is ---------------------------------
MCP_BLOTTER=blotter-sql
MCP_PRICING=pricing-sql
MCP_REFDATA=refdata-sql
MCP_ROLLUP=rollup-sql

PG_BLOTTER_SECRET=OTC_DEMO_PG_BLOTTER_DSN
PG_PRICING_SECRET=OTC_DEMO_PG_PRICING_DSN
PG_REFDATA_SECRET=OTC_DEMO_PG_REFDATA_DSN
PG_ROLLUP_SECRET=OTC_DEMO_PG_ROLLUP_DSN

POLICY_NAME=rates-broker-no-refdata

AGENT_NAME=desk-assistant
AGENT_DISPLAY_NAME="Desk Assistant"

BUDGET_NAME=otc-desk-agent-demo
BUDGET_LIMIT_USD=25
BUDGET_WARN_USD=20
