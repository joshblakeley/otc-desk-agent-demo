# Copy to env/secrets.env and fill in. The real file is gitignored.
#
# The role passwords live only here. 01-secret.sh builds each DSN from them
# plus PG_HOST/PG_PORT/PG_DATABASE and stores it as a cluster secret, so a
# full connection string never lands in a committed file.

# Owner DSN, used only by psql from your machine (schema, grants, seed data).
# Never pushed to the cluster, never given to an MCP server. Point it at the
# `postgres` database: 02-db.sh creates PG_DATABASE and connects to it itself.
PG_ADMIN_DSN="postgres://<admin>:<password>@<host>:5432/postgres?sslmode=require"

# One password per least-privilege login. Generate each with:
#   openssl rand -hex 20
PG_BLOTTER_PW="<blotter_sql password>"
PG_PRICING_PW="<pricing_sql password>"
PG_REFDATA_PW="<refdata_sql password>"
PG_ROLLUP_PW="<rollup_sql password>"
